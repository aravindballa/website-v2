---
const navItems = [
  { href: '/writings/', label: 'Writings' },
  { href: '/bookshelf/', label: 'Bookshelf' },
  { href: '/speaking/', label: 'Speaking' },
  { href: 'https://caffeineletter.com/?utm_source=aravindballa.com', label: 'caffeineletter', external: true },
];
---

<header id="site-header" class="sticky top-0 z-50 bg-[var(--background)]/85 backdrop-blur-md transition-transform duration-300">
  <nav class="container mx-auto flex max-w-4xl items-center gap-4 px-4 py-4">
    <div class="flex flex-1 items-center">
      <a href="/" class="shrink-0 hover:opacity-80" aria-label="Homepage">
        <img src="/logo.png" alt="" class="size-9 dark:hidden" />
        <img src="/logo-dark.png" alt="" class="size-9 not-dark:hidden" />
      </a>
    </div>

    <div class="flex items-center gap-6 max-md:hidden">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-sm text-[var(--muted)] hover:text-[var(--foreground)]"
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
        >
          {item.label}
        </a>
      ))}
    </div>

    <div class="flex flex-1 items-center justify-end gap-1">
      <button
        id="theme-toggle"
        type="button"
        class="relative rounded-full p-2 text-[var(--muted)] hover:bg-[var(--surface)] hover:text-[var(--foreground)] max-md:hidden"
        aria-label="Toggle theme"
      >
        <span class="pointer-fine:hidden absolute top-1/2 left-1/2 size-[max(100%,3rem)] -translate-1/2" aria-hidden="true"></span>
        <svg class="size-5 not-dark:hidden" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
        </svg>
        <svg class="size-5 dark:hidden" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
        </svg>
      </button>
      <button
        id="mobile-menu-toggle"
        type="button"
        class="relative rounded-full p-2 text-[var(--muted)] hover:bg-[var(--surface)] md:hidden"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
      >
        <span class="pointer-fine:hidden absolute top-1/2 left-1/2 size-[max(100%,3rem)] -translate-1/2" aria-hidden="true"></span>
        <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-[var(--border)]/60 md:hidden">
    <div class="container mx-auto flex max-w-4xl flex-col gap-1 px-4 py-3">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="py-2.5 text-[var(--muted)] hover:text-[var(--foreground)]"
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
        >
          {item.label}
        </a>
      ))}
      <button
        id="theme-toggle-mobile"
        type="button"
        class="relative self-start rounded-full px-2 py-2.5 text-[var(--muted)] hover:bg-[var(--surface)]"
        aria-label="Toggle theme"
      >
        <span class="pointer-fine:hidden absolute top-1/2 left-1/2 size-[max(100%,3rem)] -translate-1/2" aria-hidden="true"></span>
        Theme
      </button>
    </div>
  </div>
</header>

<script>
  const html = document.documentElement;
  const theme = localStorage.getItem('theme') || 'light';
  html.classList.toggle('dark', theme === 'dark');

  function toggleTheme() {
    const isDark = html.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  }

  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);

  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuToggle?.addEventListener('click', () => {
    const open = mobileMenu?.classList.toggle('hidden') === false;
    mobileMenuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  let lastScrollY = window.scrollY;
  const header = document.getElementById('site-header');

  window.addEventListener('scroll', () => {
    const currentScrollY = window.scrollY;
    if (currentScrollY > lastScrollY && currentScrollY > 80) {
      header?.classList.add('-translate-y-full');
    } else {
      header?.classList.remove('-translate-y-full');
    }
    lastScrollY = currentScrollY;
  });
</script>
