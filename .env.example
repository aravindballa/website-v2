# Share the Blog database with your Notion integration (Read content capability).
# Set these in the build environment, not just as Cloudflare runtime secrets.
NOTION_TOKEN=
NOTION_DATABASE_ID=3d7116c5-4027-8039-b31d-ccf190c96b82

# Use Notion as the source of truth. Missing credentials fail the build.
CONTENT_SOURCE=notion
# For offline development with the retained migration backup: CONTENT_SOURCE=local
