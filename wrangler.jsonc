{
  "name": "website-v2",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-02-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "secrets": {
    "required": ["READWISE_TOKEN", "NOTION_TOKEN", "NOTION_DATABASE_ID"]
  },
  "observability": {
    "enabled": true
  }
}
